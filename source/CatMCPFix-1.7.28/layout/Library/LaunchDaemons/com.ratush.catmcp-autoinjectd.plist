<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ratush.catmcp-autoinjectd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/catmcp-autoinjectd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/mobile/Library/Preferences/catmcp-autoinjectd.launch.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Library/Preferences/catmcp-autoinjectd.launch.log</string>
</dict>
</plist>
